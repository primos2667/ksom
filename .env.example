# Copy to .env.local and fill in values from Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Needed to view private student ID photos and approve sellers.
# Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Your auth.users UUID (Authentication → Users). Only this account can open /admin/verifications
NEXT_PUBLIC_ADMIN_USER_ID=your-uuid-here
